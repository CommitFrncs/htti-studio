# ═══════════════════════════════════════════════════════════
# HTTI Studio — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. It's already in .gitignore.
# ═══════════════════════════════════════════════════════════

# ── htmlcsstoimage API credentials ──
# Get these from: https://htmlcsstoimage.com/dashboard
HTTI_USER_ID=your_htti_user_id_here
HTTI_API_KEY=your_htti_api_key_here

# ── Firebase Admin SDK ──
# Go to Firebase Console → Project Settings → Service Accounts
# Click "Generate new private key" → Download the JSON file
# Paste the ENTIRE JSON as a single-line string here (escape inner quotes)
# Tip: Run this to get it on one line: cat serviceAccount.json | jq -c .
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}

# ── CORS — Your frontend URL ──
# Netlify example: https://your-app-name.netlify.app
# Or your custom domain
ALLOWED_ORIGIN=https://your-frontend-url.netlify.app

# ── Server port (Render/Railway will override this automatically) ──
PORT=4000
